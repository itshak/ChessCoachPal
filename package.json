{
  "name": "chesscoachpal",
  "version": "0.1.9",
  "private": true,
  "scripts": {
    "auth:email:check": "node scripts/auth-email-template-check.mjs",
    "build": "next build",
    "dev": "next dev",
    "dev:fresh": "npx --yes kill-port 3000 3001 3002 && next dev",
    "i18n:check": "node scripts/i18n-catalog-check.mjs",
    "i18n:literal-audit": "node scripts/i18n-literal-audit.mjs",
    "lint": "eslint",
    "mcp:catalog:quality": "node scripts/mcp-tool-workflow-audit.mjs",
    "mcp:parity:audit": "node scripts/mcp-parity-audit.mjs",
    "mcp:parity:guard-test": "node --test scripts/coach-gateway-rpc-parity.test.mjs scripts/policy-mcp-fields.test.mjs scripts/mcp-parity-pr-guard.test.mjs scripts/mcp-parity-audit.test.mjs scripts/parity-evidence.test.mjs scripts/mcp-legacy-actions.test.mjs scripts/mcp-unversioned-tool-names.test.mjs",
    "mcp:parity:strict": "node scripts/mcp-tool-workflow-audit.mjs && node scripts/mcp-parity-audit.mjs --strict",
    "pretypecheck": "npm run i18n:check && npm run i18n:literal-audit && npm run auth:email:check",
    "release:check": "node --test scripts/release-check.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:validate": "node scripts/release.mjs validate",
    "schema:attendance:inventory": "node scripts/canonical-cutover-audit.mjs",
    "schema:attendance:strict": "node scripts/canonical-cutover-audit.mjs --strict",
    "schema:canonical:guard": "node scripts/pre1-schema-guard.mjs",
    "schema:canonical:guard-test": "node --test scripts/pre1-schema-guard.test.mjs scripts/schema-transition-contract.test.mjs scripts/canonical-cutover-audit.test.mjs scripts/canonical-lessons-guard.test.mjs scripts/pre1-final-cutover-audit.test.mjs scripts/unified-schema-freeze.test.mjs scripts/schema-rls-coverage.test.mjs scripts/final-saas-schema-foundation.test.mjs scripts/final-schema-source-inventory.test.mjs",
    "schema:transitions:contract": "node scripts/pre1-schema-guard.mjs && node --test scripts/schema-transition-contract.test.mjs",
    "schema:canonical:strict": "node scripts/pre1-schema-guard.mjs --strict-materials",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pre1:final-cutover:audit": "node scripts/pre1-final-cutover-audit.mjs",
    "schema:final:inventory": "node scripts/final-schema-source-inventory.mjs --json",
    "schema:final:inventory:strict": "node scripts/final-schema-source-inventory.mjs --strict"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bidi-js": "1.0.3",
    "fflate": "^0.8.3",
    "gigachess": "0.5.0",
    "ics": "^3.12.0",
    "next": "16.4.1",
    "next-intl": "4.15.1",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.9.2",
    "resend": "^6.17.1",
    "stripe": "^22.3.1",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
